<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhotoTools2.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PhotoTools2.Models"
    AllowDrop="True"
    DragEnter="Page_DragEnter"
    Drop="Page_Drop"
    Loaded="Page_Loaded">
    <Grid Padding="32,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Albums" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Browse, search, and manage your photo collection from one place." />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,4,0,0" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="Photo collection" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Drop a collection folder anywhere in this window, or choose one below." />
                </StackPanel>
                <TextBox x:Name="CollectionPathBox" Grid.Row="1" IsReadOnly="True" PlaceholderText="No collection selected" />
                <Button Grid.Row="1" Grid.Column="1" Click="BrowseButton_Click" Content="Choose folder" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Click="RefreshButton_Click" Content="Refresh" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find" PlaceholderText="Search albums" TextChanged="SearchBox_TextChanged" />
            <TextBlock x:Name="AlbumCountText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 albums" />
        </Grid>
        <ListView x:Name="AlbumList" Grid.Row="3" ItemsSource="{x:Bind Albums}" SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AlbumItem">
                    <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OpenAlbum_Click" Tag="{x:Bind}" Text="Open album" />
                                <MenuFlyoutItem Click="UseAlbum_Click" Tag="{x:Bind}" Text="Use in Photo Tools" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="RefreshAlbum_Click" Tag="{x:Bind}" Text="Refresh status" />
                                <MenuFlyoutItem Click="CopyPath_Click" Tag="{x:Bind}" Text="Copy folder path" />
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="8"><FontIcon Glyph="&#xE8B7;" /></Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Path}" />
                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal" Spacing="8">
                                    <Border Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10"><TextBlock FontSize="11" Text="{x:Bind PhotoLabel}" /></Border>
                                    <Border Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10"><TextBlock FontSize="11" Text="{x:Bind PngLabel}" /></Border>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="2" Padding="10,5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="12"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind Status}" /></Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <InfoBar x:Name="StatusBar" Grid.Row="4" IsClosable="False" IsOpen="True" Message="Choose or drop a photo collection to begin." Severity="Informational" />
    </Grid>
</Page>
