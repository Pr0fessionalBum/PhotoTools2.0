<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="PhotoTools2.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PhotoTools2.Models"
    xmlns:controls="using:PhotoTools2.Controls"
    AllowDrop="True" DragEnter="Page_DragEnter" Drop="Page_Drop" Loaded="Page_Loaded">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="8,8,8,0" Spacing="3"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Tools"/><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Workspace mode"/></StackPanel>
                <StackPanel Grid.Row="1" Spacing="6">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ToolButton_Click" Tag="0"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8B7;"/><TextBlock Text="Albums"/></StackPanel></Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ToolButton_Click" Tag="1"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE7A8;"/><TextBlock Text="Crop / Trim"/></StackPanel></Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ToolButton_Click" Tag="2"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8B5;"/><TextBlock Text="Replacements"/></StackPanel></Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ToolButton_Click" Tag="3"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8A5;"/><TextBlock Text="PNG to JPG"/></StackPanel></Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ToolButton_Click" Tag="4"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8C8;"/><TextBlock Text="Front / Back"/></StackPanel></Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ToolButton_Click" Tag="5"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8AC;"/><TextBlock Text="Fix Numbering"/></StackPanel></Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ToolButton_Click" Tag="6"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE9D9;"/><TextBlock Text="Photo Stats"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="6"><TextBlock Margin="8,0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="EXTERNAL"/><Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ExternalToolButton_Click" Tag="duplicates" Content="Duplicate Finder"/><Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ExternalToolButton_Click" Tag="vuescan" Content="VueScan"/></StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceHost" Grid.Column="1">
            <Grid x:Name="AlbumsWorkspace" Padding="20" ColumnSpacing="14" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.ColumnSpan="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock FontSize="26" FontWeight="SemiBold" Text="Albums"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Browse folders and work directly with your photos."/></StackPanel>
                    <Button Grid.Column="2" Click="BrowseButton_Click" Style="{StaticResource AccentButtonStyle}" Content="Choose collection"/>
                </Grid>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="BackFolderButton" Click="BackFolder_Click" IsEnabled="False" Content="Back"/>
                    <TextBox x:Name="CollectionPathBox" Grid.Column="1" IsReadOnly="True" PlaceholderText="Choose or drop a collection folder"/>
                    <Button x:Name="RefreshButton" Grid.Column="2" Click="RefreshButton_Click" Content="Refresh"/>
                    <Button Grid.Column="3" Click="OpenCollection_Click" Content="Open in Explorer"/>
                </Grid>
                <Border Grid.Row="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="16" FontWeight="SemiBold" Text="Folders"/><TextBlock x:Name="AlbumCountText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 folders"/></Grid>
                        <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" QueryIcon="Find" PlaceholderText="Find a folder" TextChanged="SearchBox_TextChanged"/>
                        <ListView x:Name="AlbumList" Grid.Row="2" ItemsSource="{x:Bind Albums}" SelectionChanged="AlbumList_SelectionChanged" SelectionMode="Single">
                            <ListView.ItemTemplate><DataTemplate x:DataType="models:AlbumItem"><Grid Padding="8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" Glyph="&#xE8B7;"/><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}"/><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PhotoLabel}"/></StackPanel><Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Click="OpenAlbum_Click" Tag="{x:Bind}" Text="Open album"/><MenuFlyoutItem Click="UseAlbum_Click" Tag="{x:Bind}" Text="Use in Photo Tools"/><MenuFlyoutSeparator/><MenuFlyoutItem Click="RefreshAlbum_Click" Tag="{x:Bind}" Text="Refresh status"/><MenuFlyoutItem Click="CopyPath_Click" Tag="{x:Bind}" Text="Copy folder path"/></MenuFlyout></Grid.ContextFlyout></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SelectedAlbumName" FontSize="20" FontWeight="SemiBold" Text="Files"/><TextBlock x:Name="SelectedAlbumPath" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Select a folder to view its contents." TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="UseSelectedButton" Grid.Column="1" Click="UseSelectedAlbum_Click" Content="Use album" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="OpenSelectedButton" Grid.Column="2" Click="OpenSelectedAlbum_Click" Content="Open" IsEnabled="False"/></Grid>
                        <Grid Grid.Row="1" ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><AutoSuggestBox x:Name="FileSearchBox" QueryIcon="Find" PlaceholderText="Search files in this folder" TextChanged="FileSearchBox_TextChanged"/><ComboBox x:Name="FileSortBox" Grid.Column="1" Width="112" SelectedIndex="0" SelectionChanged="FileSortBox_SelectionChanged"><ComboBoxItem Content="Name"/><ComboBoxItem Content="Date"/><ComboBoxItem Content="Type"/><ComboBoxItem Content="Size"/></ComboBox><Button x:Name="FileSortDirectionButton" Grid.Column="2" Click="FileSortDirection_Click" Content="A–Z" ToolTipService.ToolTip="Reverse sort direction"/><Button Grid.Column="3" Click="SelectAllFiles_Click" Content="All" ToolTipService.ToolTip="Select all visible items"/><Button Grid.Column="4" Click="InvertFiles_Click" Content="Invert"/><Button Grid.Column="5" Click="ClearFiles_Click" Content="Clear"/><TextBlock x:Name="FileCountText" Grid.Column="6" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 items"/></Grid>
                        <GridView x:Name="FileGrid" Grid.Row="2" ItemsSource="{x:Bind BrowserItems}" IsItemClickEnabled="True" ItemClick="FileGrid_ItemClick" DoubleTapped="FileGrid_DoubleTapped" KeyDown="FileGrid_KeyDown" SelectionChanged="FileGrid_SelectionChanged" SelectionMode="Multiple">
                            <GridView.ItemTemplate><DataTemplate x:DataType="models:FileBrowserItem"><Grid Width="140" Height="160" Margin="4"><Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Click="OpenBrowserItem_Click" Tag="{x:Bind}" Text="Open"/><MenuFlyoutItem Click="RevealBrowserItem_Click" Tag="{x:Bind}" Text="Show in Explorer"/></MenuFlyout></Grid.ContextFlyout><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"><Grid><FontIcon FontSize="42" Glyph="{x:Bind FallbackGlyph}"/><Image Source="{x:Bind ThumbnailUri}" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Row="1" Margin="2,5,2,0"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Details}"/></StackPanel></Grid></DataTemplate></GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Border>
            </Grid>
            <controls:CropWorkspace x:Name="CropWorkspace" Visibility="Collapsed"/>
            <controls:ReplacementWorkspace x:Name="ReplacementWorkspace" Visibility="Collapsed"/>
            <controls:PngToJpgWorkspace x:Name="ConvertWorkspace" Visibility="Collapsed"/>
            <controls:RenameWorkspace x:Name="DuplexWorkspace" Visibility="Collapsed" Tag="Duplex"/>
            <controls:RenameWorkspace x:Name="NumberingWorkspace" Visibility="Collapsed" Tag="Numbering"/>
            <controls:StatsWorkspace x:Name="StatsWorkspace" Visibility="Collapsed"/>
        </Grid>
        <InfoBar x:Name="StatusBar" Grid.Row="1" Grid.Column="1" Margin="20,8,20,14" IsClosable="False" IsOpen="True" Message="Choose or drop a photo collection to begin." Severity="Informational"/>
    </Grid>
</Page>
