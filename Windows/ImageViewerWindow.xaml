<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PhotoTools2.Viewer.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Padding="14" RowSpacing="10" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsTabStop="True" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="PreviousButton" Click="Previous_Click" Content="← Previous"/>
            <Button x:Name="NextButton" Grid.Column="1" Click="Next_Click" Content="Next →"/>
            <TextBlock x:Name="FileNameText" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="3" Click="ZoomOut_Click" Content="−" ToolTipService.ToolTip="Zoom out"/>
            <Button Grid.Column="4" Click="ZoomIn_Click" Content="+" ToolTipService.ToolTip="Zoom in"/>
            <Button Grid.Column="5" Click="ActualSize_Click" Content="100%"/>
            <Button Grid.Column="6" Click="Fit_Click" Content="Fit" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DetailsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="PositionText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
        <Grid x:Name="ViewerHost" Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="OriginalPane" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="10">
                <Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="OriginalPaneLabel" FontWeight="SemiBold" Text="Image"/>
                    <ScrollViewer x:Name="ImageScroller" Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="10" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="ImageSurface" Background="#FF111111">
                            <Image x:Name="ViewerImage" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0" Stretch="None" ImageOpened="ViewerImage_ImageOpened"><Image.RenderTransform><CompositeTransform x:Name="ViewerTransform"/></Image.RenderTransform></Image>
                            <Canvas.ContextFlyout><MenuFlyout><MenuFlyoutItem Click="Previous_Click" Text="Previous image"/><MenuFlyoutItem Click="Next_Click" Text="Next image"/><MenuFlyoutSeparator/><MenuFlyoutItem Click="Fit_Click" Text="Fit to window"/><MenuFlyoutItem Click="ActualSize_Click" Text="Actual size (100%)"/><MenuFlyoutSeparator/><MenuFlyoutItem Click="OpenDefault_Click" Text="Open with default app"/><MenuFlyoutItem Click="Reveal_Click" Text="Show in Explorer"/><MenuFlyoutItem Click="CopyPath_Click" Text="Copy path"/></MenuFlyout></Canvas.ContextFlyout>
                        </Canvas>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border x:Name="HighlightedPane" Grid.Column="1" Padding="8" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="10">
                <Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock FontWeight="SemiBold" Text="Highlighted detection"/>
                    <ScrollViewer x:Name="HighlightScroller" Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="10" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="HighlightSurface" Background="#FF111111"><Image x:Name="HighlightImage" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None"/><Border x:Name="LineMarker" Background="#FFFF3B30" BorderBrush="White" BorderThickness="1" IsHitTestVisible="False"/></Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="EditToolbar" Grid.Row="3" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Edit"/><Button Grid.Column="1" Click="RotateLeft_Click" Content="Rotate left (Q)"/><Button Grid.Column="2" Click="RotateRight_Click" Content="Rotate right (E)"/><Button x:Name="ResetEditsButton" Grid.Column="3" Click="ResetEdits_Click" Content="Reset current" IsEnabled="False"/><StackPanel Grid.Column="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10"><TextBlock x:Name="EditStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No pending rotations"/><Button x:Name="ApplyRotationsButton" Click="ApplyRotations_Click" Content="Apply all rotations" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Grid>
        <Grid Grid.Row="4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Zoom"/><Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="10" Maximum="1000" Value="100" ValueChanged="ZoomSlider_ValueChanged"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Drag to pan • Scroll to zoom • Q/E rotate • Left/Right navigate"/><TextBlock x:Name="ZoomText" Grid.Column="3" VerticalAlignment="Center" Text="100%"/></Grid>
    </Grid>
</Window>
