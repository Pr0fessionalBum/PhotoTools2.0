<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhotoTools2.Controls.ReplacementWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:PhotoTools2.Models" IsTabStop="True" KeyDown="Workspace_KeyDown">
    <Grid Padding="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="26" FontWeight="SemiBold" Text="Process Replacements"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Compare originals with cropped and JPG staging files before applying them."/></StackPanel><Button x:Name="CompareButton" Grid.Column="1" Click="Compare_Click" Content="Compare selected" IsEnabled="False"/><Button Grid.Column="2" Click="ChooseFolder_Click" Content="Choose album"/></Grid>
        <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderPathBox" KeyDown="FolderPathBox_KeyDown" PlaceholderText="Paste a folder path and press Enter"/><Button Grid.Column="1" Click="UpFolder_Click" Content="Up"/><Button Grid.Column="2" Click="Refresh_Click" Content="Refresh"/><Button Grid.Column="3" Click="Open_Click" Content="Open"/></Grid>
        <Grid Grid.Row="2"><Grid x:Name="BrowserPane" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="MatchedCountText" FontSize="17" FontWeight="SemiBold" Text="Matching originals · 0"/><GridView x:Name="MatchedOriginalGrid" Grid.Row="1" ItemsSource="{x:Bind MatchedOriginals}" DoubleTapped="OriginalGrid_DoubleTapped" SelectionMode="Single"><GridView.ItemTemplate><DataTemplate x:DataType="models:FileBrowserItem"><Grid Width="126" Height="144" Margin="3"><Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Click="OpenOriginal_Click" Tag="{x:Bind}" Text="Open photo"/><MenuFlyoutItem Click="RevealOriginal_Click" Tag="{x:Bind}" Text="Show in Explorer"/></MenuFlyout></Grid.ContextFlyout><Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="3" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="7"><Image Source="{x:Bind ThumbnailUri}" Stretch="Uniform"/></Border><TextBlock Grid.Row="1" Margin="2,4" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></GridView.ItemTemplate></GridView><TextBlock x:Name="OtherCountText" Grid.Row="2" Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold" Text="Other originals · 0"/><GridView x:Name="OtherOriginalGrid" Grid.Row="3" ItemsSource="{x:Bind OtherOriginals}" DoubleTapped="OriginalGrid_DoubleTapped" SelectionMode="Single"><GridView.ItemTemplate><DataTemplate x:DataType="models:FileBrowserItem"><Grid Width="110" Height="126" Margin="3"><Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Click="OpenOriginal_Click" Tag="{x:Bind}" Text="Open photo"/><MenuFlyoutItem Click="RevealOriginal_Click" Tag="{x:Bind}" Text="Show in Explorer"/></MenuFlyout></Grid.ContextFlyout><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="7"><Image Source="{x:Bind ThumbnailUri}" Stretch="Uniform"/></Border><TextBlock Grid.Row="1" Margin="2,4" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></GridView.ItemTemplate></GridView></Grid></Border>
            <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ReplacementCountText" FontSize="17" FontWeight="SemiBold" Text="Ready replacements · 0"/><GridView x:Name="ReplacementGrid" Grid.Row="1" ItemsSource="{x:Bind Replacements}" DoubleTapped="ReplacementGrid_DoubleTapped" SelectionChanged="ReplacementGrid_SelectionChanged" SelectionMode="Single"><GridView.ItemTemplate><DataTemplate x:DataType="models:ReplacementItem"><Grid Width="140" Height="174" Margin="3"><Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Click="OpenReplacement_Click" Tag="{x:Bind}" Text="Open replacement"/><MenuFlyoutItem Click="OpenMatchedOriginal_Click" Tag="{x:Bind}" Text="Open matched original"/><MenuFlyoutItem Click="RevealReplacement_Click" Tag="{x:Bind}" Text="Show in Explorer"/></MenuFlyout></Grid.ContextFlyout><Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="7"><Image Source="{x:Bind Thumbnail}" Stretch="Uniform"/></Border><StackPanel Grid.Row="1" Margin="2,4"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Stage}"/><TextBlock FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind MatchStatus}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></GridView.ItemTemplate></GridView></Grid></Border>
        </Grid>
            <Border x:Name="ComparePane" Visibility="Collapsed" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="12"><Grid RowSpacing="12" ColumnSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="Original"/><TextBlock Grid.Column="1" FontSize="18" FontWeight="SemiBold" Text="Replacement"/><Border Grid.Row="1" Padding="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"><Image x:Name="CompareOriginalImage" Stretch="Uniform"/></Border><Border Grid.Row="1" Grid.Column="1" Padding="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"><Image x:Name="CompareReplacementImage" Stretch="Uniform"/></Border><Grid Grid.Row="2" Grid.ColumnSpan="2"><TextBlock x:Name="CompareNamesText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Click="PreviousCompare_Click" Content="Previous"/><Button Click="NextCompare_Click" Content="Next"/><Button Click="CloseCompare_Click" Content="Close comparison" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Grid></Grid></Border>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No replacements found. Empty staging folders will never trigger cleanup."/><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Click="Cancel_Click" Content="Cancel" IsEnabled="False"/><Button x:Name="ProcessButton" Grid.Column="2" Click="Process_Click" Content="Process replacements" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/></Grid>
    </Grid>
</UserControl>
