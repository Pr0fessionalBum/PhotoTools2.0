<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhotoTools2.Controls.CropWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PhotoTools2.Models"
    AllowDrop="True" DragEnter="Workspace_DragEnter" Drop="Workspace_Drop">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="26" FontWeight="SemiBold" Text="Crop / Trim Photos"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Trim scanner backgrounds into a reviewable cropped folder. Originals are never changed here."/></StackPanel><Border Grid.Column="1" Padding="10,5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="12"><TextBlock x:Name="ImageCountText" Text="0 images"/></Border></Grid>
        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderPathBox" KeyDown="FolderPathBox_KeyDown" PlaceholderText="Paste a folder path and press Enter"/><Button Grid.Column="1" Click="UpFolder_Click" Content="Up"/><Button Grid.Column="2" Click="ChooseFolder_Click" Content="Choose source"/><Button Grid.Column="3" Click="OpenFolder_Click" Content="Open"/><Button Grid.Column="4" Click="ChooseOutputRoot_Click" Content="Choose output root"/><Button Grid.Column="5" Click="ResetOutputRoot_Click" Content="Use album folder"/><TextBlock x:Name="OutputPathText" Grid.Row="1" Grid.ColumnSpan="6" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Output: source album\cropped" TextTrimming="CharacterEllipsis"/></Grid>
        <Border Grid.Row="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Color tolerance"/><NumberBox x:Name="FuzzBox" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" Value="12" SpinButtonPlacementMode="Inline"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Extra edge trim"/><NumberBox x:Name="ShaveBox" Grid.Column="3" Minimum="0" Maximum="25" SmallChange="1" Value="2" SpinButtonPlacementMode="Inline"/><TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Percent"/></Grid></Border>
        <Border Grid.Row="3" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
            <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Nothing selected — all images will be processed"/><ComboBox x:Name="SortBox" Grid.Column="1" Width="112" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged"><ComboBoxItem Content="Name"/><ComboBoxItem Content="Date"/><ComboBoxItem Content="Type"/><ComboBoxItem Content="Size"/></ComboBox><Button x:Name="SortDirectionButton" Grid.Column="2" Click="SortDirection_Click" Content="A–Z"/><Button Grid.Column="3" Click="SelectAll_Click" Content="Select all"/><Button Grid.Column="4" Click="InvertSelection_Click" Content="Invert"/><Button Grid.Column="5" Click="ClearSelection_Click" Content="Clear"/></Grid>
            <GridView x:Name="SourceGrid" Grid.Row="1" ItemsSource="{x:Bind SourceImages}" DoubleTapped="SourceGrid_DoubleTapped" SelectionChanged="SourceGrid_SelectionChanged" SelectionMode="Multiple"><GridView.ItemTemplate><DataTemplate x:DataType="models:FileBrowserItem"><Grid Width="140" Height="158" Margin="4"><Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Click="OpenPhoto_Click" Tag="{x:Bind}" Text="Open"/><MenuFlyoutItem Click="RevealPhoto_Click" Tag="{x:Bind}" Text="Show in Explorer"/></MenuFlyout></Grid.ContextFlyout><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"><Grid><FontIcon FontSize="42" Glyph="{x:Bind FallbackGlyph}"/><Image Source="{x:Bind ThumbnailUri}" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Row="1" Margin="2,5,2,0"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Details}"/></StackPanel></Grid></DataTemplate></GridView.ItemTemplate></GridView></Grid>
        </Border>
        <Grid Grid.Row="4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="ProgressText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Choose an album containing PNG or JPG photos."/><ProgressBar x:Name="CropProgress" Height="4" Minimum="0" Maximum="100" Value="0"/></StackPanel><Button x:Name="ReviewButton" Grid.Column="1" Click="ReviewButton_Click" Content="Review cropped folder" IsEnabled="False"/><Button x:Name="ContinueButton" Grid.Column="2" Click="ContinueButton_Click" Content="Continue to replacements" IsEnabled="False"/><Button x:Name="CancelButton" Grid.Column="3" Click="CancelButton_Click" Content="Cancel" IsEnabled="False"/><Button x:Name="RunButton" Grid.Column="4" Click="RunButton_Click" Content="Crop photos" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/></Grid>
    </Grid>
</UserControl>
