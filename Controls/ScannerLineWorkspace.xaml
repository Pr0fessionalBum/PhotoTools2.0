<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PhotoTools2.Controls.ScannerLineWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PhotoTools2.Models"
    AllowDrop="True" DragEnter="Workspace_DragEnter" Drop="Workspace_Drop">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="26" FontWeight="SemiBold" Text="Scanner-line Detection"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inspect every photo for a narrow continuous scanner streak. Other photos are used only to confirm uncertain results; originals are never changed."/></StackPanel><ProgressRing x:Name="BusyRing" Grid.Column="1" Width="28" Height="28" IsActive="False"/></Grid>
        <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderPathBox" KeyDown="FolderPathBox_KeyDown" PlaceholderText="Paste a folder path and press Enter"/><Button Grid.Column="1" Click="UpFolder_Click" Content="Up"/><Button Grid.Column="2" Click="ChooseFolder_Click" Content="Choose folder"/><Button Grid.Column="3" Click="OpenFolder_Click" Content="Open"/></Grid>
        <Border Grid.Row="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Sensitivity"/><Slider x:Name="SensitivitySlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.1" Value="0.55"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Higher finds fainter lines but may flag real vertical details."/><CheckBox x:Name="IncludeSubfoldersBox" Grid.Column="3" VerticalAlignment="Center" IsChecked="True" Checked="IncludeSubfolders_Changed" Unchecked="IncludeSubfolders_Changed" Content="Include subfolders"/><Border Grid.Column="4" Padding="10,5" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="12"><TextBlock x:Name="ImageCountText" Text="0 images"/></Border></Grid></Border>
        <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="Folder contents"/><ListView x:Name="FolderItemsList" Grid.Row="1" DoubleTapped="FolderItemsList_DoubleTapped" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate x:DataType="models:FileBrowserItem"><Grid Padding="5" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind FallbackGlyph}"/><TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
            <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="Detection results"/><TextBlock x:Name="ResultSummaryText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ready to inspect photos individually."/></StackPanel><FontIcon Grid.Column="1" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE9D9;"/></Grid><GridView x:Name="ResultsGrid" Grid.Row="1" DoubleTapped="ResultsGrid_DoubleTapped" SelectionMode="Single"><GridView.ItemTemplate><DataTemplate x:DataType="models:ScannerLineResult"><Border Width="210" Height="276" Margin="4" Padding="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10"><Grid RowSpacing="5"><Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="7"><Grid Tag="{x:Bind}" SizeChanged="PreviewGrid_SizeChanged"><Image Source="{x:Bind Photo.ThumbnailUri}" Stretch="Uniform" ImageOpened="PreviewImage_ImageOpened"/><Border Width="3" HorizontalAlignment="Left" Background="#FFFF3B30" BorderBrush="White" BorderThickness="1" IsHitTestVisible="False"><ToolTipService.ToolTip><ToolTip Content="Detected scanner-line position"/></ToolTipService.ToolTip></Border></Grid></Border><TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{x:Bind Photo.Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="2" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind PositionLabel}" TextWrapping="Wrap"/><TextBlock Grid.Row="3" FontSize="12" FontWeight="SemiBold" Text="{x:Bind ConfidenceLabel}"/><TextBlock Grid.Row="4" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Explanation}" TextWrapping="Wrap" MaxLines="2"/><ProgressBar Grid.Row="5" Height="5" Maximum="100" Value="{x:Bind ConfidencePercent}"/></Grid></Border></DataTemplate></GridView.ItemTemplate></GridView></Grid></Border>
        </Grid>
        <Grid Grid.Row="4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Choose a folder containing scans."/><ProgressBar x:Name="AnalysisProgress" Height="4" Minimum="0" Maximum="100"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Click="Cancel_Click" Content="Cancel" IsEnabled="False"/><Button x:Name="AnalyzeButton" Grid.Column="2" Click="Analyze_Click" Content="Analyze photos" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/></Grid>
    </Grid>
</UserControl>
