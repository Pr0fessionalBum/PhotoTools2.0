<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PhotoTools2.Controls.StatsWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PhotoTools2.Models"
    AllowDrop="True" DragEnter="Workspace_DragEnter" Drop="Workspace_Drop">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="26" FontWeight="SemiBold" Text="Photo Stats"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Album inventory and creation-time scanning sessions for billing."/></StackPanel><ProgressRing x:Name="BusyRing" Grid.Column="1" Width="28" Height="28" VerticalAlignment="Center"/></Grid>
        <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderPathBox" KeyDown="FolderPathBox_KeyDown" PlaceholderText="Paste a folder path and press Enter"/><Button Grid.Column="1" Click="UpFolder_Click" Content="Up"/><Button Grid.Column="2" Click="ChooseFolder_Click" Content="Choose folder"/><Button Grid.Column="3" Click="OpenFolder_Click" Content="Open in Explorer"/></Grid>
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Photos"/><TextBlock x:Name="PhotoCountText" FontSize="24" FontWeight="SemiBold" Text="0"/></StackPanel></Border>
            <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Folders"/><TextBlock x:Name="FolderCountText" FontSize="24" FontWeight="SemiBold" Text="0"/></StackPanel></Border>
            <Border Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Total size"/><TextBlock x:Name="TotalSizeText" FontSize="24" FontWeight="SemiBold" Text="0 B"/></StackPanel></Border>
            <Border Grid.Column="3" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Active scan time"/><TextBlock x:Name="ActiveTimeText" FontSize="24" FontWeight="SemiBold" Text="0 min"/></StackPanel></Border>
            <StackPanel Grid.Column="4" Width="150" Spacing="3"><TextBlock Text="Idle gap (minutes)"/><NumberBox x:Name="GapMinutesBox" Minimum="1" Maximum="1440" Value="60" SpinButtonPlacementMode="Inline"/><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Starts a new billing section" TextWrapping="Wrap"/></StackPanel>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="Scanning timeline"/><TextBlock x:Name="SessionSummaryText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Generate stats to calculate sessions from creation dates."/></StackPanel><FontIcon Grid.Column="1" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE823;"/></Grid><ListView x:Name="SessionsList" Grid.Row="1" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:PhotoSessionItem"><Border Margin="0,0,0,7" Padding="11" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="15"><FontIcon FontSize="14" Glyph="&#xE121;"/></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{x:Bind DateLabel}"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TimeLabel}"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{x:Bind DurationLabel}"/><TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CountLabel}"/></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
            <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><StackPanel Spacing="10"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Album details"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Average image size"/><TextBlock x:Name="AverageSizeText" FontSize="18" FontWeight="SemiBold" Text="0 B"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Date range (modified)"/><TextBlock x:Name="DateRangeText" Text="No images scanned" TextWrapping="Wrap"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="File types"/><ItemsControl x:Name="FileTypesList"/><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="Creation timestamps can change when files are copied or converted. Verify them before billing."/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Choose an album to begin."/><ProgressBar x:Name="ScanProgress" Height="4"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Click="Cancel_Click" Content="Cancel" IsEnabled="False"/><Button x:Name="ExportButton" Grid.Column="2" Click="Export_Click" Content="Export CSV" IsEnabled="False"/><Button x:Name="GenerateButton" Grid.Column="3" Click="Generate_Click" Content="Generate stats" Style="{StaticResource AccentButtonStyle}"/></Grid>
    </Grid>
</UserControl>
