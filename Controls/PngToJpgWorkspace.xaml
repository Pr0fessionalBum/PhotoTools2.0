<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhotoTools2.Controls.PngToJpgWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:PhotoTools2.Models" AllowDrop="True" DragEnter="Workspace_DragEnter" Drop="Workspace_Drop">
    <Grid Padding="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="26" FontWeight="SemiBold" Text="PNG to JPG"/><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Convert selected PNG files into an automatic JPG review folder. PNG originals remain untouched."/></StackPanel><Border Grid.Column="1" Padding="10,5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="12"><TextBlock x:Name="CountText" Text="0 PNG files"/></Border></Grid>
        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderPathBox" KeyDown="FolderPathBox_KeyDown" PlaceholderText="Paste a folder path and press Enter"/><Button Grid.Column="1" Click="UpFolder_Click" Content="Up"/><Button Grid.Column="2" Click="ChooseFolder_Click" Content="Choose source"/><Button Grid.Column="3" Click="OpenFolder_Click" Content="Open"/><Button Grid.Column="4" Click="ChooseOutputRoot_Click" Content="Choose output root"/><Button Grid.Column="5" Click="ResetOutputRoot_Click" Content="Use album folder"/><TextBlock x:Name="OutputPathText" Grid.Row="1" Grid.ColumnSpan="6" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Output: source album\JPG" TextTrimming="CharacterEllipsis"/></Grid>
        <Border Grid.Row="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="JPG quality"/><NumberBox x:Name="QualityBox" Grid.Column="1" Minimum="1" Maximum="100" Value="92" SpinButtonPlacementMode="Inline"/><TextBlock x:Name="SelectionText" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Nothing selected — all PNG files will be converted"/><Button Grid.Column="3" Click="SelectAll_Click" Content="Select all"/><Button Grid.Column="4" Click="Invert_Click" Content="Invert"/><Button Grid.Column="5" Click="Clear_Click" Content="Clear"/></Grid></Border>
        <Border Grid.Row="3" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><GridView x:Name="PngGrid" ItemsSource="{x:Bind PngImages}" DoubleTapped="PngGrid_DoubleTapped" KeyDown="PngGrid_KeyDown" SelectionChanged="PngGrid_SelectionChanged" SelectionMode="Multiple"><GridView.ItemTemplate><DataTemplate x:DataType="models:FileBrowserItem"><Grid Width="140" Height="158" Margin="4"><Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Click="OpenPhoto_Click" Tag="{x:Bind}" Text="Open"/><MenuFlyoutItem Click="RevealPhoto_Click" Tag="{x:Bind}" Text="Show in Explorer"/></MenuFlyout></Grid.ContextFlyout><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"><Grid><FontIcon FontSize="42" Glyph="{x:Bind FallbackGlyph}"/><Image Source="{x:Bind ThumbnailUri}" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Row="1" Margin="2,5"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Details}"/></StackPanel></Grid></DataTemplate></GridView.ItemTemplate></GridView></Border>
        <Grid Grid.Row="4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="ProgressText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Choose an album containing PNG files."/><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100"/></StackPanel><Button x:Name="ReviewButton" Grid.Column="1" Click="Review_Click" Content="Review JPG folder" IsEnabled="False"/><Button x:Name="ContinueButton" Grid.Column="2" Click="Continue_Click" Content="Continue to replacements" IsEnabled="False"/><Button x:Name="CancelButton" Grid.Column="3" Click="Cancel_Click" Content="Cancel" IsEnabled="False"/><Button x:Name="ConvertButton" Grid.Column="4" Click="Convert_Click" Content="Convert to JPG" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/></Grid>
    </Grid>
</UserControl>
